# ==============================================
# MenuQR — Multi-Tenant QR Digital Menu SaaS
# Copy to .env and fill in your environment values
# ==============================================

# PostgreSQL connection string (required)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menuqr_mvp?schema=public"
DATABASE_URL="postgresql://postgres:tanuj@123@localhost:5432/qr_code_local_db"

# Public application URL used for QR code links and Auth.js callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
AUTH_TRUST_HOST="true"

# Optional: Image Storage Provider ("local" | "cloudinary" | "supabase")
# Defaults to "local" in development (stores under public/uploads).
# For Vercel / production deployments, configure Cloudinary or Supabase Storage.
STORAGE_PROVIDER="local"

# Cloudinary (required when STORAGE_PROVIDER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Supabase Storage (required when STORAGE_PROVIDER="supabase")
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="menu-images"

# Optional: Default super admin credentials used by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@tablory.online"
SEED_ADMIN_PASSWORD="ChangeMeAdmin@123"
# Set to "true" only if you intentionally want the demo restaurant seeded in production
SEED_DEMO_DATA="false"

# Optional: Distributed serverless rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend Transactional Email (Verification, Welcome & Order Receipts)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tablory <onboarding@resend.dev>"

# Razorpay (India INR Billing: UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Lemon Squeezy (International USD / Global Billing)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=""
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=""
LEMONSQUEEZY_VARIANT_GROWTH_MONTHLY=""
LEMONSQUEEZY_VARIANT_GROWTH_YEARLY=""
