generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MenuTemplate {
  MODERN
  CLASSIC
  MINIMAL
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
}

enum QRCodeType {
  GENERAL
  TABLE
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

enum BillingCycle {
  TRIAL
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH_AT_COUNTER
  UPI_ONLINE
  CARD
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RESTAURANT_OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships RestaurantMembership[]

  @@index([role])
  @@index([createdAt])
}

model Restaurant {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  logoUrl             String?
  coverImageUrl       String?
  description         String?
  phone               String?
  whatsappNumber      String?
  upiId               String?
  address             String?
  city                String?
  state               String?
  country             String           @default("India")
  currency            String           @default("INR")
  primaryColor        String           @default("#E15A2B")
  template            MenuTemplate     @default(MODERN)
  status              RestaurantStatus @default(ACTIVE)
  isPublished         Boolean          @default(false)
  onboardingCompleted Boolean          @default(false)
  onboardingStep      Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  memberships  RestaurantMembership[]
  categories   Category[]
  menuItems    MenuItem[]
  tables       RestaurantTable[]
  qrCodes      QRCode[]
  scanEvents   QRScanEvent[]
  subscription Subscription?
  orders       Order[]

  @@index([status, isPublished])
  @@index([createdAt])
}

model RestaurantMembership {
  id           String         @id @default(cuid())
  userId       String
  restaurantId String
  role         MembershipRole @default(OWNER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, displayOrder])
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String
  categoryId   String?
  name         String
  description  String?
  imageUrl     String?
  price        Decimal     @db.Decimal(10, 2)
  dietaryType  DietaryType @default(VEG)
  isAvailable  Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([restaurantId, categoryId, displayOrder])
  @@index([restaurantId, isAvailable])
}

model RestaurantTable {
  id           String   @id @default(cuid())
  restaurantId String
  tableNumber  String
  label        String?
  capacity     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCodes    QRCode[]
  scanEvents QRScanEvent[]
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, isActive])
}

model QRCode {
  id            String     @id @default(cuid())
  restaurantId  String
  tableId       String?
  type          QRCodeType @default(TABLE)
  token         String     @unique
  isActive      Boolean    @default(true)
  regeneratedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  scanEvents QRScanEvent[]

  @@index([restaurantId, type, isActive])
  @@index([tableId, isActive])
}

model QRScanEvent {
  id           String     @id @default(cuid())
  restaurantId String
  qrCodeId     String
  tableId      String?
  scannedAt    DateTime   @default(now())
  userAgent    String?
  deviceType   DeviceType @default(UNKNOWN)
  ipHash       String?

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCode     QRCode           @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId, scannedAt])
  @@index([qrCodeId, scannedAt])
  @@index([restaurantId, tableId, scannedAt])
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  monthlyPrice   Decimal  @db.Decimal(10, 2)
  yearlyPrice    Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR")
  trialDays      Int      @default(14)
  maxRestaurants Int      @default(1)
  maxTables      Int      @default(15)
  maxMenuItems   Int      @default(150)
  features       Json     @default("[]")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                 String             @id @default(cuid())
  restaurantId       String             @unique
  planId             String
  billingCycle       BillingCycle       @default(TRIAL)
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, trialEndsAt])
  @@index([planId])
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  tableId       String?
  orderNumber   String
  customerName  String?
  customerPhone String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_AT_COUNTER)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, tableId])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
  subtotal   Decimal  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}
